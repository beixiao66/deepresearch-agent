# ===== 阿里云百炼（Model Studio）=====
# 获取：https://bailian.console.aliyun.com/ 控制台 → API-KEY
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ===== Tavily 联网搜索 =====
# 获取：https://tavily.com 注册后获取 API Key
TAVILY_API_KEY=your-tavily-api-key

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 数据库 =====
# 相对路径基于启动目录；若服务以其他目录启动，请用绝对路径
DATABASE_URL=sqlite+aiosqlite:///./data/deepresearch.db

# ===== 文件上传 =====
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE=10485760
UPLOAD_CHUNK_SIZE=1048576

# ===== Qdrant =====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=deepresearch_documents
